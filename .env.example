# AskWarehouse runs entirely on a local, free model by default (no key
# needed). Copy this file to .env and set one of these to switch providers.

# ASKWAREHOUSE_PROVIDER=local   # local | anthropic | openai (auto-detected from keys below if unset)

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

ASKWAREHOUSE_SESSION_USER=you@example.com
