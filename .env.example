# ---------------------------------------------------------------------------
# AskWarehouse configuration
# ---------------------------------------------------------------------------
# Locally the CLI/REPL still default to the free on-GPU Qwen model (no key).
# The Vercel deployment has no GPU, so it uses a hosted model instead -- set
# ONE of the keys below. Free tiers that work well here:
#   * Gemini  -> https://aistudio.google.com/apikey   (generous tokens/min)
#   * Groq    -> https://console.groq.com/keys        (very fast)
#
# Provider is auto-detected from whichever key is present. Force it with
# ASKWAREHOUSE_PROVIDER = gemini | groq | anthropic | openai | local

# GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ASKWAREHOUSE_PROVIDER=gemini
# ASKWAREHOUSE_MODEL=gemini-2.0-flash

# Soft per-IP limit on the shared server key (questions/min). BYO-key
# requests from the UI are never limited.
# ASKWAREHOUSE_RL_PER_MIN=6

ASKWAREHOUSE_SESSION_USER=you@example.com

# ---------------------------------------------------------------------------
# Serverless-only path overrides (set automatically by api/index.py on Vercel;
# you normally don't touch these)
# ---------------------------------------------------------------------------
# ASKWAREHOUSE_WAREHOUSE_PATH=data/warehouse/warehouse.duckdb
# ASKWAREHOUSE_AUDIT_DB_PATH=/tmp/askwarehouse/audit.duckdb
# ASKWAREHOUSE_CACHE_DB_PATH=/tmp/askwarehouse/cache.duckdb
